Description: Restore legacy extension API aliases
 Restore XtOffsetOf and INI_STR aliases used by out-of-tree extensions.
 Map them to the standard offsetof and PHP 8.6 zend_ini_string_literal APIs,
 without overriding definitions supplied by other headers.
---
 Zend/zend_ini.h   | 3 +++
 Zend/zend_types.h | 6 ++++++
 2 files changed, 9 insertions(+)

diff --git a/Zend/zend_types.h b/Zend/zend_types.h
index 0000000..0000000 100644
--- a/Zend/zend_types.h
+++ b/Zend/zend_types.h
@@ -19,6 +19,12 @@
 #ifndef ZEND_TYPES_H
 #define ZEND_TYPES_H
 
+#include <stddef.h>
+
+#ifndef XtOffsetOf
+# define XtOffsetOf(type, field) offsetof(type, field)
+#endif
+
 #include "zend_portability.h"
 #include "zend_long.h"
 #include "zend_atomic.h"
diff --git a/Zend/zend_ini.h b/Zend/zend_ini.h
index 0000000..0000000 100644
--- a/Zend/zend_ini.h
+++ b/Zend/zend_ini.h
@@ -89,6 +89,9 @@
 #define zend_ini_bool_literal(name) zend_ini_parse_bool(zend_ini_str((name), sizeof("" name) - 1, false))
 #define zend_ini_long_literal(name) zend_ini_long((name), sizeof("" name) - 1, false)
 #define zend_ini_double_literal(name) zend_ini_double((name), sizeof("" name) - 1, false)
+#ifndef INI_STR
+# define INI_STR(name) zend_ini_string_literal(name)
+#endif
 #define zend_ini_str_literal(name) zend_ini_str((name), sizeof("" name) - 1, false)
 #define zend_ini_string_literal(name) zend_ini_string((name), sizeof("" name) - 1, false)
