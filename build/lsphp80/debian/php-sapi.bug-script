#!/bin/sh

MATCH="^[[:space:]]*($|;)"

echo "==== Additional LSPHP 8.0 information ====" >&3
echo "" >&3
echo "++++ LSPHP 8.0 SAPI (php8.0query -S): ++++" >&3
/usr/local/lsws/lsphp80/bin/phpquery -S >&3
echo "" >&3
echo "++++ LSPHP 8.0 Extensions (php8.0query -M -v): ++++" >&3
/usr/local/lsws/lsphp80/bin/phpquery -M -v >&3
echo "" >&3

echo "++++ Configuration files: ++++" >&3
"**** /usr/local/lsws/lsphp80/etc/php/8.0/litespeed/php.ini ****" >&3
grep -Ev "$MATCH" /usr/local/lsws/lsphp80/etc/php/8.0/litespeed/php.ini >&3
echo "" >&3
find /usr/local/lsws/lsphp80/etc/php/8.0/mods-available/ -name '*.ini' | \
while read CONF; do
    echo "**** $CONF ****" >&3
    grep -Ev "$MATCH" "$CONF" >&3
    echo "" >&3
done
